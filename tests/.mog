options (
	shell=/bin/bash
	source_file=
	env_files=../.env, .env.local
)
# commenting
import (
    a_dir as up
)

myvar = hi
v_path = [which v]
something = {v_path}/place
name = [uname -s | tr "[:upper:]" "[:lower:]"]

@options(
	shell=zsh
	source_file=~/.zshrc
)
test:
    echo "don't {v_path} ${SHELL} stuff"
	echo 'foo \{ bar'
	echo $ZSH_THEME
	echo $0
    echo ${TESTING1}
    echo ${TESTING2}
    echo ${TESTING3}
    echo ${TESTING4}
    echo ${TESTING5}
    echo ${TESTING6}
	echo {myvar}
	echo "\"\{{v_path}'"
	echo {something}
	echo yell {$1} and {$2}
    {up.test2} shmoo {$2}
    echo yarp

test2:
    if [[ "{$1}" == "" ]]; then
		echo nothing
	else
		echo a thing {$1}
	fi
	echo $0
	echo done

test3:
    echo wallaby {$1}

@options(
	shell=/bin/bash
	source_file=
)
@desc(for testing)
test4:
	echo {$bold}{v_path}{$normal_intensity}
	{up.test}
	echo {$dim}{$1}
	echo {$green}${EDITOR}
	hogwash {$silence_out_err} || echo no hogwash{$normal}

test5:
	echo test5

test6:
    {up.test}
	echo {$#}
	echo {up.val}
	for arg in {$"@"}; do
		echo "- $arg"
	done

test7:
	echo yarp
	@if {$@} == {myvar}
		echo stuff
	@elif {$@} == other
		echo doing other
	@elif {$@} == thing
		echo doing thing
	@elif empty ./tests
		echo tests is empty
	@else
		echo not matching
	@fi
	echo done

test8:
	@if ${SHELL} == /bin/dsh
		echo using dsh
		echo $(uname -s)
	@elif ${SHELL} == /bin/zsh
		echo using zsh
		echo $(uname -m)
	@fi

test9:
	@if $(uname -m) == arm64
		echo using arm
	@fi

test10:
	echo {name}
	@if {name} == darwin
		echo using MacOS
	@fi

test11:
	@if {$1} > 4
		echo greater than 4
	@else
		echo less than or equal to 4
	@fi

test12:
	@if {$@} > 4 #and {$@} < 8
		echo greater than 4 and less than 8
	@else
		echo not within range
	@fi

test13:
	@if {$1} == ""
		{test14}
		if ! grep -q shell "../config"; then
			echo no shell path
		fi
		{up.test}
	@elif {$2} == "foo"
		{up.test2} dev foo
	@elif {$1} == ci
		echo matched ci
	@fi

test14:
	echo in test14

test15:
	@if {$1} == "check"
		echo yes arg is check
	@else
		echo arg is not check
	@fi

@options(
	exit_on_error=false
)
test16:
	OUT=0
	echo $OUT
	OUT=$(echo $?)
	# this will not work because the if statements are evaluated before the task
	# itself is run so the variable $OUT is not available yet to compare against
	@if $OUT == 0
		echo command worked
	@else
		echo did not work
	@fi
	echo $OUT

@options(
	shell=/opt/homebrew/bin/python3
	source_file=
)
test17:
	print("hello")
	import this

test18:
	@if {$1} == 5
		@if {$2} == foo
			@if {$3} == bar
				echo is bar
			@else
				echo not bar
			@fi
		@else
			echo not foo
		@fi
	@else
		echo arg is not 5
	@fi

@options(
	new_shell_per_line=true
)
test19:
	export F=foo
	echo $F
	export B=bar && echo $B
