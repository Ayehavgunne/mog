import (
    a_dir as up
)

myvar = hi
v_path = [which v]
something = {v_path}/place
name = [uname -s | tr "[:upper:]" "[:lower:]"]

test:
	pwd
    echo "don't {v_path} ${SHELL} stuff"
	echo 'foo \{ bar'
	echo $ZSH_THEME
	echo $0
    echo ${EDITOR}
	echo {myvar}
	echo "\"\{{v_path}'"
	echo {something}
	echo yell {$1} and {$2}
    {up.test2} shmoo peep
    echo yarp

test2:
    if [[ "{$1}" == "" ]]; then
		echo nothing
	else
		echo a thing {$1}
	fi
	echo done

test3:
    echo wallaby {$1}

@options(
	shell_path=/bin/bash
	source_file=
)
@desc(for testing)
test4:
	echo {$bold}{v_path}{$normal_intensity}
	{up.test}
	sleep 2
	echo {$dim}{$1}
	echo Enter your name
	read name
	echo {$normal_intensity}hello ${name}
	echo {$green}${EDITOR}
	hogwash {$silence_out_err} || echo no hogwash

test5:
	pwd
	echo test5

test6:
    {up.test}
	echo {$#}
	echo {up.val}
	for arg in {$"@"}; do
		echo "- $arg"
	done
	pwd

test7:
	echo yarp
	@if {$@} == {myvar} (
		echo stuff
		pwd
		ls
	) @elif {$@} == other (
		echo doing other
	) @elif {$@} > 4 (
		echo greater than 4
	) @elif {$@} == thing (
		echo doing thing
	) @elif empty ./tests (
		echo tests is empty
	) @else (
		echo not matching
	)
	echo done

test8:
	@if ${SHELL} == /bin/dsh (
		echo using dsh
		echo $(uname -s)
	) @elif ${SHELL} == /bin/zsh (
		echo using zsh
	)

test9:
	@if $(uname -m) == arm64 (
		echo using arm
	)

test10:
	echo {name}
	@if {name} == darwin (
		echo using MacOS
	)
