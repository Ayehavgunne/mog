import (
    a_dir as up
)

myvar = hi
v_path = [which v]
something = {v_path}/place


test:
	pwd
    echo "don't {v_path} ${SHELL} stuff"
	echo 'foo \{ bar'
	echo $ZSH_THEME
	echo $0
    echo ${EDITOR}
	echo {myvar}
	echo "\"\{{v_path}'"
	echo {something}
	echo yell {$1} and {$2}
    {up.test2} shmoo peep
    echo yarp

test2:
    if [[ "{$1}" == "" ]]; then
		echo nothing
	else
		echo a thing {$1}
	fi
	echo done

test3:
    echo wallaby {$1}

@options(
	shell_path=/bin/bash
	source_file=
)
@desc(for testing)
test4:
	echo {$bold}{v_path}{$normal_intensity}
	{up.test}
	sleep 2
	echo {$dim}{$1}
	echo Enter your name
	read name
	echo {$normal_intensity}hello ${name}
	echo {$green}${EDITOR}
	hogwash {$silence_out_err} || echo no hogwash

test5:
	pwd
	echo test5

test6:
    {up.test}
	echo {$#}
	echo {up.val}
	for arg in {$"@"}; do
		echo "- $arg"
	done
	pwd
