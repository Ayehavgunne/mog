src = src
v_path = [which v]
version = [cat src/v.mod | grep version | cut -d ":" -f 2 | xargs]
kernel = [uname -s | tr "[:upper:]" "[:lower:]"]
arch = [uname -m | tr "[:upper:]" "[:lower:]" | sed -e 's/aarch64/arm64/g' -e 's/x86_64/amd64/g']
upload_path = ./release/mog_{kernel}_{arch}
test_args = 5 foo bar baz
mog_test_args = -p=tests --no-exit-code

default:
    {fmt}

@desc(run mog with debug output)
run_trace:
	v -d trace_logs run {src}

b:
	{build}

@desc(build mog into an executable)
build:
	mkdir -p release && v -prod -o release/mog {src} && echo built

@desc(check if code can be compiled successfully)
check:
	v -check {src} && echo code is good

@desc(format mog code to v standards)
fmt:
	v fmt {src} -w

commit:
	git add -A
	git commit -m "{$@}"
	git push

c:
	{commit}

amend:
	git add -A
	@if {$#} == 0
		git commit --amend --no-edit
	@else
		git commit --amend -m {$"*"}
	@fi
	git push -f

a:
	{amend}

tag:
    git tag {version}
    git push origin --tags

release:
    cp ./release/mog {upload_path}
    @if {$1} == ""
        gh release create {version} {upload_path}
    @else
        gh release upload --clobber {version} {upload_path}
    @fi

@options(
    shell_path=/bin/bash
    source_file=
    hide_exit_code_output=true
    exit_on_error=false
)
test:
    @if {$1} != ""
        {_compare_test_file}
    @else
        TESTS=( $(mog -p=tests -l --no-desc) )
        for arg in "${TESTS[@]}"; do
            {_compare_test_file} ${arg}
        done
    @fi

_compare_test_file:
    OUT=$(mog {mog_test_args} {$1} {test_args})
    if [[ "$(< tests/{$1}.txt)" != "$OUT" ]]; then
        echo Test {$1} failed
    fi

write_test_file:
    mog {mog_test_args} {$1} {test_args} > tests/{$1}.txt
