import (
 	path/to/other/dir/with/.mog/file # will be namespaced with the name of the directory
 	path/to/another/dir as my_alias # you can alias directory names in case of conflicts
)

# a comment

py_version = 3.13
py = python{py_version}
h=hello world
v_path = [which v] # calls shell command and stores it into variable
bracket = \[ # escape opening brackets like [ and {
# No need to escape ( since it isn't used in an interpolation context

test2:
	echo in examples
	pwd

@desc(run my project)
run:
    {build}
	{start}
	{my_alias.some_task_name} # refering to a task from an import
	echo ${EDITOR} # using a bash env var
	{py} my_script.py

@desc(build my project)
build:
	{py} build_script.py

@desc(clean up some stuff)
clean:
	rm .file_or_whatev

start:
	echo '{h}'
	{v_path} run .

@options( # override the default configs per task with the options decorator
    shell=/bin/bash
    source_file=
)
@desc(for testing)
test:
	echo hello
	echo {my_alias.some_var} # refering to a variable from an import
	hogwash || echo no hogwash

# a task named 'default' will be called if mog is called without a specific task name
default:
    {test}

test_ifs:
	echo yarp
	@if {$@} == {myvar}
		echo stuff
		pwd
		ls
	@elif {$@} == other
		echo doing other
	@elif {$@} == thing
		echo doing thing
	@elif empty ./tests  # `empty` works on both files and directory paths
		echo tests is empty
	@else
		echo not matching
	@fi
	echo done

test_if_dollar_curly_bracket:
	@if ${SHELL} == /bin/zsh
		echo using zsh
		echo $(uname -s)
	@fi

test_if_dollar_parenthesis:
	@if $(uname -m) == arm64
		echo using arm
	@fi

test_if_replacement:
	echo {name}
	@if {name} == darwin
		echo using MacOS
	@fi

test_num_comp:
	@if {$@} > 4
		echo greater than 4
	@else
		echo less than or equal to 4
	@fi
