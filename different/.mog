)



test2:
    if [[ "{$1}" == "" ]]; then
		echo nothing
	else
		echo a thing {$1}
	fi
	echo done

test3:
    echo wallaby {$1}

@desc(for testing)
test4:
	echo {$bold}{v_path}{$normal_intensity}
	{up.test}
	sleep 2
	echo {$dim}{$1}
	echo Enter your name
	read name
	echo {$normal_intensity}hello ${name}
	echo {$green}${EDITOR}
	hogwash {$silence_out_err} || echo no hogwash

test5:
	pwd
	echo test2

